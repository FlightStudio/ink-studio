{
	"name": "ink-studio-v2",
	"private": true,
	"packageManager": "pnpm@10.33.4",
	"scripts": {
		"dev": "turbo run dev dev:render",
		"lint": "biome check . && pnpm --filter tools check",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"build": "turbo run build",
		"api:generate": "pnpm --filter @repo/api generate",
		"db:migrate": "pnpm --filter tools migrate",
		"db:studio": "pnpm --filter @repo/db exec drizzle-kit studio",
		"seed": "pnpm --filter tools seed",
		"test:e2e": "pnpm --filter web test:e2e",
		"screens": "pnpm --filter tools screens",
		"prepare": "lefthook install || true"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
		"lefthook": "^2.0.14",
		"turbo": "^2.6.1"
	}
}
