{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"test": {
			"dependsOn": ["^test"]
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"dev:render": {
			"cache": false,
			"persistent": true
		}
	}
}
