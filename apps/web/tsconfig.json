{
	"extends": "@repo/typescript-config/base.json",
	"compilerOptions": {
		"lib": ["es2023", "dom", "dom.iterable"],
		"jsx": "preserve",
		"plugins": [{ "name": "next" }],
		"paths": {
			"@/*": ["./src/*"]
		},
		"allowJs": true,
		"noEmit": true,
		"incremental": true
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}
